.fullPage-content { display: flex; flex-direction: column; align-content: center; margin: 80px 20% 40px; width: 60%; text-align: center; font-family: var(--font-primary); height: inherit; }

.fullPage-content.w70 { width: 70%; margin: auto 15%; }

