<span class="k">def</span> <span class="nf">predict_disease</span><span class="p">(</span><span class="n">input_symptoms</span><span class="p">):</span>
    <span class="n">input_symptoms</span> <span class="o">=</span> <span class="n">input_symptoms</span><span class="o">.</span><span class="n">split</span><span class="p">(</span><span class="s2">","</span><span class="p">)</span>
    <span class="n">input_data</span> <span class="o">=</span> <span class="p">[</span><span class="mi">0</span><span class="p">]</span> <span class="o">*</span> <span class="nb">len</span><span class="p">(</span><span class="n">symptom_index</span><span class="p">)</span>
    
    <span class="k">for</span> <span class="n">symptom</span> <span class="ow">in</span> <span class="n">input_symptoms</span><span class="p">:</span>
        <span class="k">if</span> <span class="n">symptom</span> <span class="ow">in</span> <span class="n">symptom_index</span><span class="p">:</span>
            <span class="n">input_data</span><span class="p">[</span><span class="n">symptom_index</span><span class="p">[</span><span class="n">symptom</span><span class="p">]]</span> <span class="o">=</span> <span class="mi">1</span>
    
    <span class="n">input_data</span> <span class="o">=</span> <span class="n">np</span><span class="o">.</span><span class="n">array</span><span class="p">(</span><span class="n">input_data</span><span class="p">)</span><span class="o">.</span><span class="n">reshape</span><span class="p">(</span><span class="mi">1</span><span class="p">,</span> <span class="o">-</span><span class="mi">1</span><span class="p">)</span>

    <span class="n">rf_pred</span> <span class="o">=</span> <span class="n">encoder</span><span class="o">.</span><span class="n">classes_</span><span class="p">[</span><span class="n">rf_model</span><span class="o">.</span><span class="n">predict</span><span class="p">(</span><span class="n">input_data</span><span class="p">)[</span><span class="mi">0</span><span class="p">]]</span>
    <span class="n">nb_pred</span> <span class="o">=</span> <span class="n">encoder</span><span class="o">.</span><span class="n">classes_</span><span class="p">[</span><span class="n">nb_model</span><span class="o">.</span><span class="n">predict</span><span class="p">(</span><span class="n">input_data</span><span class="p">)[</span><span class="mi">0</span><span class="p">]]</span>
    <span class="n">svm_pred</span> <span class="o">=</span> <span class="n">encoder</span><span class="o">.</span><span class="n">classes_</span><span class="p">[</span><span class="n">svm_model</span><span class="o">.</span><span class="n">predict</span><span class="p">(</span><span class="n">input_data</span><span class="p">)[</span><span class="mi">0</span><span class="p">]]</span>

    <span class="n">final_pred</span> <span class="o">=</span> <span class="n">mode</span><span class="p">([</span><span class="n">rf_pred</span><span class="p">,</span> <span class="n">nb_pred</span><span class="p">,</span> <span class="n">svm_pred</span><span class="p">])</span>
    
    <span class="k">return</span> <span class="p">{</span>
        <span class="s2">"Random Forest Prediction"</span><span class="p">:</span> <span class="n">rf_pred</span><span class="p">,</span>
        <span class="s2">"Naive Bayes Prediction"</span><span class="p">:</span> <span class="n">nb_pred</span><span class="p">,</span>
        <span class="s2">"SVM Prediction"</span><span class="p">:</span> <span class="n">svm_pred</span><span class="p">,</span>
        <span class="s2">"Final Prediction"</span><span class="p">:</span> <span class="n">final_pred</span>
    <span class="p">}</span>

<span class="nb">print</span><span class="p">(</span><span class="n">predict_disease</span><span class="p">(</span><span class="s2">"Itching,Skin Rash,Nodal Skin Eruptions"</span><span class="p">))</span>
</pre></div></code>
