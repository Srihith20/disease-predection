    <code class="language-python3"><div class="highlight"><pre><span></span><span class="k">if</span> <span class="s1">'gender'</span> <span class="ow">in</span> <span class="n">X_resampled</span><span class="o">.</span><span class="n">columns</span><span class="p">:</span>
