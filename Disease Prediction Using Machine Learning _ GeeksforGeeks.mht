.modal-form-group { margin-top: 15px; margin-bottom: 15px; position: relative; }

.modal-form-group .input-icon { opacity: 1; position: absolute; z-index: 1; left: 8px; top: 10px; color: rgb(151, 159, 175); font-size: 26px; }

.modal-form-group .modal-form-input { height: auto; width: 100%; display: block !important; padding: 15px 8px 8px 45px !important; }

.modal-form-group .modal-form-input::placeholder { color: rgb(153, 153, 153); font-weight: 200; font-size: 16px; }

@media (max-width: 768px) {
  .login-modal-div { padding-top: 30px; }
  .login-modal-div .modal-content { width: 90%; }
}

.login-modal-div .modal-header section { display: none; padding: 20px 30px 30px; border-top: 1px solid rgb(221, 221, 221); border-right: 1px solid rgb(221, 221, 221); border-left: 1px solid rgb(221, 221, 221); border-image: initial; border-bottom: none; }

.login-modal-div .modal-header input[type="radio"] { display: none; }

.login-modal-div .modal-header label.tab-label { display: inline-block; margin: 0px 0px -1px; padding: 15px 25px 12px; font-weight: 600; text-align: center; color: rgb(136, 136, 136); border-width: 1px 1px 4px; border-style: solid; border-color: transparent; border-image: initial; width: 50%; font-size: 20px; background-color: rgb(233, 235, 238); }

.login-modal-div .modal-header label.tab-label:first-of-type { float: left; }

.login-modal-div .modal-header label.tab-label::before { font-weight: normal; margin-right: 10px; }

.login-modal-div .modal-header label:hover { color: rgb(136, 136, 136); cursor: pointer; }

.login-modal-div .modal-header input:checked + label.tab-label { color: rgb(85, 85, 85); border-width: 2px 1px 3px; border-style: solid; border-color: rgb(15, 157, 88) rgb(221, 221, 221) rgb(255, 255, 255); border-image: initial; background-color: rgb(255, 255, 255); }

@media screen and (max-width: 650px) {
  .login-modal-div .modal-header label.tab-label::before { margin: 0px; font-size: 18px; }
}

@media screen and (max-width: 400px) {
  .login-modal-div .modal-header label.tab-label { padding: 15px; }
}

.login-modal-div .left { text-align: left; }

.login-modal-div .right { text-align: right; }

.login-modal-div .pull-right { float: right; }

.login-modal-div .pull-left { float: left; }

.modal-form-label { vertical-align: middle; font-weight: 400; color: rgb(64, 64, 64); font-size: 12px; position: relative; top: -4px; margin-left: 2px; line-height: 100%; letter-spacing: 0px; }

.login-modal-div a { color: rgb(151, 159, 175); }

.login-modal-div a:hover { color: rgb(15, 157, 88); text-decoration: underline; }

.login-modal-div .btn { background-color: whitesmoke; background-image: linear-gradient(rgb(43, 190, 96), rgb(15, 157, 88)); border: 1px solid rgb(15, 157, 88); border-radius: 3px; box-shadow: rgba(0, 0, 0, 0.08) 0px 1px 3px, rgba(151, 159, 175, 0.2) 0px -1px 4px inset; box-sizing: border-box; cursor: pointer; display: inline-block; padding: 10px 20px; margin-bottom: 0px; font-size: 16px; font-weight: 500; line-height: 18px; position: relative; color: rgb(57, 66, 78); text-align: center; vertical-align: middle; text-decoration: none !important; }

.login-modal-div .btn-green { color: rgb(255, 255, 255); background-color: rgb(15, 157, 88); width: 100%; text-shadow: none; }

.login-modal-div .forgot-link, .login-modal-div .login-link { cursor: pointer; position: relative; font-family: var(--font-primary); margin-right: 17px; color: rgb(1, 108, 204) !important; font-size: 14px !important; font-weight: 500 !important; }

.login-modal-div .forgot-link:hover, .login-modal-div .login-link:hover { text-decoration: underline; }

.login-modal-div .social-signin-div { border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221); border-left: 1px solid rgb(221, 221, 221); border-image: initial; border-top: none; padding-bottom: 20px; }

.login-modal-div .social-signin-div .social-div { width: 50%; display: inline-block; padding: 5px 30px; }

.login-modal-div .social-signin-div .tnc-div { font-size: 10px; padding: 0px 15px; color: rgb(153, 153, 153); margin-top: 10px; margin-bottom: 0px; }

.login-modal-div .social-signin-div .tnc-div a { color: rgb(15, 157, 88); }

.login-modal-div .social-signin-div .social-divider { width: 80%; text-align: center; border-bottom: 1px solid rgb(151, 159, 175); line-height: 0.1em; margin: -20px 0px 20px 10%; }

.login-modal-div .social-signin-div .social-divider span { background: rgb(255, 255, 255); padding: 0px 10px; }

.login-modal-div .social-signin-div .btn-social { padding-left: 40px; color: rgb(255, 255, 255); }

.login-modal-div .social-signin-div .btn-social span.fa { padding-top: 2px; }

.login-modal-div .social-signin-div .btn-google { background-image: linear-gradient(rgb(221, 78, 65), rgb(201, 69, 58)); color: rgb(255, 255, 255); border: 1px solid rgb(201, 69, 58); padding-left: 60px; }

.login-modal-div .social-signin-div .btn-facebook { background-image: linear-gradient(rgb(75, 102, 160), rgb(59, 89, 152)); color: rgb(255, 255, 255); border: 1px solid rgb(59, 89, 152); }

.login-modal-div .social-signin-div .btn-linkedin { background-image: linear-gradient(rgb(0, 115, 177), rgb(7, 91, 140)); color: rgb(255, 255, 255); border: 1px solid rgb(7, 91, 140); padding-left: 60px; }

.login-modal-div .social-signin-div .btn-github { background-image: linear-gradient(rgb(74, 70, 70), rgb(25, 23, 23)); color: rgb(255, 255, 255); border: 1px solid rgb(25, 23, 23); padding-left: 60px; }

.login-modal-div .modal-header .register-div { display: none; }

.login-modal-div .forgot-div { padding: 0px 20px; display: none; }

.login-modal-div .forgot-div p:first-of-type { font-weight: 400; color: rgb(64, 64, 64); }

.login-modal-div div.input-error { font-size: 12px; color: rgb(183, 28, 28); text-align: left; position: relative; bottom: 10px; font-weight: 500; }
