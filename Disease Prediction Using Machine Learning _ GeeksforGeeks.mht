.fullPage-content__banner img { max-width: 100%; }

.fullPage-content__banner img.img-fluid { width: 100%; }

.avatarprofile_image { border-radius: 100%; vertical-align: middle; object-fit: cover; box-sizing: border-box; cursor: pointer; height: 30px !important; width: 30px !important; }

