.fullPage-content__list-item .item .content { flex-basis: 80%; margin-left: 15px; text-align: left; }

.fullPage-content__list-item .item .content .head { font-size: 24px; color: rgb(80, 49, 193); line-height: 1.67; }

.fullPage-content__list-item .item .content .info { font-size: 16px; line-height: 1.25; color: rgb(12, 12, 17); }

.fullPage-content__items { display: inline-block; padding-left: 0px; list-style: none; margin: 16px 0px; }

