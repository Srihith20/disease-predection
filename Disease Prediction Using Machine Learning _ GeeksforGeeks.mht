.fullPage-content__list { margin-top: 30px; display: flex; flex-flow: wrap; }

.fullPage-content__list-item { flex-basis: 50%; margin-bottom: 20px; }

.fullPage-content__list-item .item { margin: 0px 10px; padding: 16px; display: flex; align-items: center; background: 0px 0px no-repeat padding-box padding-box rgb(255, 255, 255); box-shadow: rgba(80, 49, 193, 0.07) 0px 3px 11px; border-radius: 8px; height: 100%; }

.fullPage-content__list-item .item .imgWrap { flex-basis: 20%; }

