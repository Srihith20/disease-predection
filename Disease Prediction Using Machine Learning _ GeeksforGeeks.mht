<span class="n">X_resampled</span> <span class="o">=</span> <span class="n">X_resampled</span><span class="o">.</span><span class="n">fillna</span><span class="p">(</span><span class="mi">0</span><span class="p">)</span>

<span class="k">if</span> <span class="nb">len</span><span class="p">(</span><span class="n">y_resampled</span><span class="o">.</span><span class="n">shape</span><span class="p">)</span> <span class="o">&gt;</span> <span class="mi">1</span><span class="p">:</span>
    <span class="n">y_resampled</span> <span class="o">=</span> <span class="n">y_resampled</span><span class="o">.</span><span class="n">values</span><span class="o">.</span><span class="n">ravel</span><span class="p">()</span>

<span class="n">models</span> <span class="o">=</span> <span class="p">{</span>
    <span class="s2">"Decision Tree"</span><span class="p">:</span> <span class="n">DecisionTreeClassifier</span><span class="p">(),</span>
